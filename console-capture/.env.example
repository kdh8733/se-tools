# ===== Message Broker (Redis) =====
CC_REDIS_URL=redis://127.0.0.1:6379/0
CC_STREAM=bmc_screen_result
CC_REQUEST_STREAM=bmc_screen_request
CC_GROUP=slackbot
CC_CONSUMER=consumer-1

# ===== CMDB / Secret =====
# 로컬 인벤토리(YAML). 실 CMDB 연동 시 cmdb.LocalInventoryCmdb를 API 구현체로 교체(README 참고).
CC_INVENTORY=inventory.yaml
# 로컬 시크릿 파일(YAML). 비우면 mock/default 더미. 운영은 Vault/Secrets Manager로 교체(OPERATIONS.md).
CC_SECRETS=

# ===== Slack =====
# 비우면 consumer가 로컬 sink(uploads/)로 fallback. 채우면 실제 Slack 업로드/메시지.
# Socket Mode: 봇 토큰(xoxb-) + 앱 레벨 토큰(xapp-) 둘 다 필요.
# 봇 scope: files:write, chat:write  (!bmc 메시지용 message.channels, /bmc용 commands)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL=
# 캡처 허용 채널 화이트리스트(CSV, 비우면 전체 허용 - 운영에선 반드시 지정)
CC_ALLOWED_CHANNELS=

# ===== 캡처/전송 정책 =====
# BMC는 보통 self-signed 인증서 -> 기본 false. 실환경 정책에 맞게 켤 것.
CC_TLS_VERIFY=false
# inline base64 한도 (덱과 동일 900 KiB). 초과 시 status=error.
CC_MAX_INLINE_BYTES=921600

# ===== 출력 디렉토리 =====
CC_CAPTURE_DIR=captures
CC_UPLOAD_DIR=uploads
